/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "types": [
      "node"
      // node_modules
    ],
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    // "paths": {
    //   "keycloak-js": ["node_modules/keycloak-js/lib/keycloak.d.ts"]
    // },
    // "exclude": ["node_modules/keycloak-js/**/*.ts"],
    // "allowSyntheticDefaultImports": true,
    // "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2015",
    "module": "es2020",
    "lib": ["es2018", "dom"]
  }
}
